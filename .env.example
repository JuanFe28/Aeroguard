# ==============================================================================
# AeroGuard C-UAS — Plantilla de Variables de Entorno (.env.example)
# ==============================================================================
# Instrucciones:
#   Copiar este archivo como '.env' en la raíz antes de iniciar el sistema:
#     Windows (PowerShell): Copy-Item .env.example .env
#     Linux / macOS:        cp .env.example .env
# ==============================================================================

# --- Aplicación ---
APP_NAME=AeroGuard
APP_VERSION=1.1.0
APP_ENV=development
DEBUG=true

# --- Servidor API ---
API_V1_PREFIX=/api/v1
PORT=8000
HOST=127.0.0.1

# --- Base de Datos PostgreSQL + PostGIS ---
# Para Docker Compose o PostgreSQL local:
POSTGRES_DB=aeroguard
POSTGRES_USER=aeroguard
POSTGRES_PASSWORD=aeroguard_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://aeroguard:aeroguard_pass@localhost:5432/aeroguard
# Fallback SQLite local (si no se dispone de PostgreSQL):
# DATABASE_URL=sqlite+aiosqlite:///./aeroguard.db

DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Seguridad y Tokens JWT ---
# Generar una clave segura en producción (mínimo 32 caracteres):
SECRET_KEY=AEROGUARD_SECURE_DEV_SECRET_KEY_FOR_LOCAL_TESTING_2026_MIN32CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
MIN_PASSWORD_LENGTH=8

# --- RabbitMQ Message Broker ---
RABBITMQ_DEFAULT_USER=aeroguard
RABBITMQ_DEFAULT_PASS=aeroguard_pass
RABBITMQ_URL=amqp://aeroguard:aeroguard_pass@localhost:5672/
RABBITMQ_EXCHANGE=aeroguard
QUEUE_AI_PROCESSING=ai.processing
QUEUE_REPORTS=reports.generation
QUEUE_NOTIFICATIONS=notifications.send
QUEUE_TELEMETRY=telemetry.incoming

# --- Microservicio de Visión Artificial (OpenCV / YOLO) ---
AI_MODEL_PATH=models/yolov8n.pt
AI_CONFIDENCE_THRESHOLD=0.70
AI_ENABLED=true
AI_USE_YOLO=false

# --- Reglas de Detección y Geocercas ---
DETECTION_MAX_ALTITUDE=1000.0
DETECTION_MIN_SPEED=0.0
DETECTION_MAX_SPEED=300.0
ANOMALY_THRESHOLD=2.5
ALERTS_ENABLED=true

# --- Logging y Monitoreo ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Correo SMTP (Opcional - Notificaciones y Reseteo) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@aeroguard.co

# --- Almacenamiento de Reportes PDF y Excel ---
REPORTS_DIR=/tmp/aeroguard/reports
MAX_REPORT_AGE_DAYS=30

# --- Automatización SOAR (n8n Webhook & Agente IA Táctico) ---
N8N_WEBHOOK_URL=http://localhost:5678/webhook/aeroguard-incident
N8N_WEBHOOK_TIMEOUT=3.5
SOAR_AI_AGENT_ENABLED=true

# --- Simulador de Sensores (sensor_simulator/simulator.py) ---
BACKEND_URL=http://127.0.0.1:8000/api/v1
SIMULATOR_TOKEN=
INTERVAL_SEC=3
