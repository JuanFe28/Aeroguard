{
  "uid": "aeroguard",
  "title": "AeroGuard \u2014 Operaci\u00f3n acad\u00e9mica",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Disponibilidad API",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "aeroguard-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "up{job=\"aeroguard\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Sensores sin telemetr\u00eda reciente",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "aeroguard-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "aeroguard_sensors_stale",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Solicitudes por segundo",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "aeroguard-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rate(aeroguard_http_requests_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Latencia P95 (segundos)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "aeroguard-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(aeroguard_http_request_seconds_bucket[5m])))",
          "refId": "A"
        }
      ]
    }
  ]
}