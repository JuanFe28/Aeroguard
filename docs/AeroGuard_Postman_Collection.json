{
  "info": {
    "name": "AeroGuard — Exposición Fase TEST",
    "description": "API local sin Docker. Ejecutar Login antes de las peticiones protegidas. Para IA, seleccionar docs/assets/drone_demo.jpg o configurar el directorio de trabajo de Postman en la raíz del repositorio. El umbral de 1000 ms es una comprobación real y puede fallar en un PC lento. El hash PDF identifica los datos del reporte, no el archivo completo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "username", "value": "admin" },
    { "key": "password", "value": "Admin@12345" },
    { "key": "access_token", "value": "" },
    { "key": "image_path", "value": "docs/assets/drone_demo.jpg" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "event": [{
    "listen": "test",
    "script": {
      "type": "text/javascript",
      "exec": [
        "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
        "pm.test('Response time < 1000 ms', function () { pm.expect(pm.response.responseTime).to.be.below(1000); });"
      ]
    }
  }],
  "item": [
    {
      "name": "01 — Salud",
      "request": { "method": "GET", "auth": { "type": "noauth" }, "url": "{{base_url}}/health" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Backend saludable', function () { pm.expect(pm.response.json().status).to.eql('healthy'); });"
      ] } }]
    },
    {
      "name": "02 — Login JWT",
      "request": {
        "method": "POST",
        "auth": { "type": "noauth" },
        "url": "{{base_url}}/api/v1/auth/token",
        "body": { "mode": "urlencoded", "urlencoded": [
          { "key": "username", "value": "{{username}}", "type": "text" },
          { "key": "password", "value": "{{password}}", "type": "text" }
        ] }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "if (pm.response.code === 200) { pm.collectionVariables.set('access_token', pm.response.json().access_token); } else { pm.collectionVariables.unset('access_token'); }",
        "pm.test('Recibe JWT bearer', function () { const body = pm.response.json(); pm.expect(body.token_type).to.eql('bearer'); pm.expect(body.access_token.split('.')).to.have.lengthOf(3); });"
      ] } }]
    },
    {
      "name": "03 — Analizar imagen",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/v1/ai/analyze",
        "body": { "mode": "formdata", "formdata": [
          { "key": "file", "type": "file", "src": "{{image_path}}" },
          { "key": "sensor_id", "type": "text", "value": "CAM-EXPO-01" }
        ] }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Confianza y bounding box válidos', function () { const d = pm.response.json().detection; pm.expect(d.confidence).to.be.within(0, 1); pm.expect(d.bounding_box.width).to.be.above(0); pm.expect(d.bounding_box.height).to.be.above(0); });",
        "pm.test('Motor de visión identificado', function () { pm.expect(pm.response.json().engine).to.be.a('string').and.not.empty; });"
      ] } }]
    },
    {
      "name": "04 — Exportar PDF",
      "request": { "method": "GET", "url": "{{base_url}}/api/v1/reports/export/pdf?type=detections" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Contenido PDF', function () { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/pdf'); pm.expect(pm.response.text().slice(0, 5)).to.eql('%PDF-'); });",
        "pm.test('Huella SHA-256 de los datos', function () { pm.expect(pm.response.headers.get('X-Report-SHA256')).to.match(/^[a-f0-9]{64}$/); });"
      ] } }]
    },
    {
      "name": "05 — Exportar Excel",
      "request": { "method": "GET", "url": "{{base_url}}/api/v1/reports/export/excel?type=detections" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Archivo Excel XLSX', function () { pm.expect(pm.response.headers.get('Content-Type')).to.include('spreadsheetml.sheet'); pm.expect(pm.response.headers.get('Content-Disposition')).to.include('.xlsx'); });"
      ] } }]
    }
  ]
}
